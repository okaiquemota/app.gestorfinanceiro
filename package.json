{
  "name": "poupin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test --experimental-strip-types shared/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply gestor-financeiro --local",
    "db:migrate:remote": "wrangler d1 migrations apply gestor-financeiro --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:embedded": "npm run build && node scripts/deploy-embedded.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  }
}
